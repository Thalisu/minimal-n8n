# Generate with: openssl rand -hex 32. Losing it makes every stored credential unreadable.
N8N_ENCRYPTION_KEY=change-me

N8N_VERSION=2.47.7
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# N8N
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# DATABASE
DB_TYPE=sqlite
DB_SQLITE_POOL_SIZE=2
DB_SQLITE_VACUUM_ON_STARTUP=true

# RUNTIME
N8N_RUNNERS_MODE=internal
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_CONCURRENCY_PRODUCTION_LIMIT=5
N8N_RUNNERS_MAX_CONCURRENCY=5
N8N_LOG_LEVEL=warn

# EXECUTIONS
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=300
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_TIMEOUT=120
EXECUTIONS_TIMEOUT_MAX=3600

# CRASH HANDLE
N8N_WORKFLOW_AUTODEACTIVATION_ENABLED=true
N8N_WORKFLOW_AUTODEACTIVATION_MAX_LAST_EXECUTIONS=5

# SECURITY
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_SKIP_AUTH_ON_OAUTH_CALLBACK=false
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000

# TELEMETRY
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
